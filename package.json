{
  "name": "world-ethglobal-lisbon-demos",
  "private": true,
  "version": "0.1.0",
  "description": "Four production-shaped World demos for ETHGlobal Lisbon builders.",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:one-human-trial": "pnpm --filter @world-lisbon/one-human-trial dev",
    "dev:selfie-onboarding": "pnpm --filter @world-lisbon/selfie-onboarding dev",
    "dev:agentkit-x402": "pnpm --filter @world-lisbon/agentkit-x402 dev",
    "dev:credential-policy-lab": "pnpm --filter @world-lisbon/credential-policy-lab dev",
    "dev:all": "pnpm --parallel --filter './apps/*' dev",
    "test": "pnpm -r --if-present test",
    "test:browser": "playwright test",
    "release:check": "node --test scripts/workspace-shape.test.mjs && pnpm test && pnpm typecheck && pnpm build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22.15.30",
    "next": "^16.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
